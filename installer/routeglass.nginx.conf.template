server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    server_tokens off;
    client_max_body_size 64k;

    include /etc/nginx/snippets/routeglass-security-headers.conf;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

__TEST_FILES_LOCATION__

    # Reject hidden files and directories before they reach RouteGlass.
    # ACME validation remains explicitly permitted above.
    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    location = /api/diagnostics {
__DIAG_RATE_LIMIT__
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
        proxy_redirect off;
    }

    # Backward-compatible BGP endpoint retained for existing API consumers.
    location = /api/bgp {
__DIAG_RATE_LIMIT__
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
        proxy_redirect off;
    }

    location / {
__WEB_RATE_LIMIT__
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
        proxy_redirect off;
    }
}
